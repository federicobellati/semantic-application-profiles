# Sensor model SHACL profile — local draft, 2026-11-16.
# Field sequence follows SBE37-SMP-ODO.ttl and the agreed document/model split.
# sh:order preserves that sequence for form renderers; RDF graphs are unordered.
# Requires SHACL Core + SHACL-SPARQL. No automatic data generation in SHACL.
# Validate asserted records WITHOUT ontology imports or entailment first.
# Apply sensorDescriptionMapping inference separately after validation.
# Closed record/block shapes reject additional predicates and unknown named blocks.
# Vocabulary checks inspect IRI prefixes only, with no network requests.
# No default sensor-specific measurements or observation type are prescribed.

@prefix sapsens: <https://w3id.org/cnr-ismar/sap/sensor/1.0.0/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix omtype: <http://www.opengis.net/def/observationType/OGC-OM/2.0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sapsens:profile.ttl
    a owl:Ontology ;
    dcterms:title "Sensor model application profile — SHACL"@en ;
    dcterms:description "Bozza locale del profilo concordato. SHACL Core e SHACL-SPARQL; validare il grafo asserito prima delle inferenze. Nessun generatore HTML incluso."@it ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9657-919X> ;
    dcterms:created "2026-11-16"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    rdfs:seeAlso <https://w3c.github.io/sdw-sosa-ssn/ssn/> .

sapsens:MetadataDocumentShape
    a sh:NodeShape ;
    sh:name "Metadata document"@en ;
    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:IRI ;
    sh:targetClass owl:Ontology ;
    sh:targetSubjectsOf dcterms:conformsTo, owl:imports ;
    sh:pattern "^https://w3id[.]org/cnr-ismar/sensors-models-registry/[A-Za-z][A-Za-z0-9_-]*[.]ttl$" ;
    sh:property sapsens:DocumentTypes, sapsens:DocumentRequiredType1, sapsens:DocumentImports, sapsens:DocumentLicense, sapsens:DocumentRights, sapsens:DocumentAccessRights, sapsens:DocumentCreator, sapsens:DocumentPublisher, sapsens:DocumentVersion, sapsens:DocumentCreated, sapsens:DocumentModified, sapsens:DocumentConformsTo, sapsens:DocumentSeeAlso, sapsens:DocumentContact ;
    sh:sparql [
        sh:message "Il documento deve descrivere il modello la cui IRI è ottenuta togliendo il suffisso .ttl."@it ;
        sh:select """SELECT $this WHERE {
  BIND(IRI(SUBSTR(STR($this), 1, STRLEN(STR($this)) - 4)) AS ?model)
  FILTER NOT EXISTS { ?model a <http://schema.org/ProductModel> }
}"""
    ] .

sapsens:DocumentTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( owl:Ontology ) ;
    sh:description "Tipo/i fisso/i e automatico/i; nessuna scelta nel modulo."@it .

sapsens:DocumentRequiredType1
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue owl:Ontology .

sapsens:DocumentImports
    a sh:PropertyShape ;
    sh:path owl:imports ;
    sh:order "0.1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:hasValue <https://w3id.org/cnr-ismar/ontology/sensorDescriptionMapping/1.0.0/> ;
    sh:description "Import fisso e automatico del mapping. L’applicazione delle inferenze dipende dal consumatore."@it .

sapsens:DocumentLicense
    a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:order "1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:hasValue <https://creativecommons.org/licenses/by/4.0/> .

sapsens:DocumentRights
    a sh:PropertyShape ;
    sh:path dcterms:rights ;
    sh:order "2"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:hasValue "The licence (dcterms:license) applies to this metadata record only; it does not cover the physical instrument."@en ;
    sh:languageIn ( "en" ) .

sapsens:DocumentAccessRights
    a sh:PropertyShape ;
    sh:path dcterms:accessRights ;
    sh:order "3"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:hasValue <http://publications.europa.eu/resource/authority/access-right/PUBLIC> .

sapsens:DocumentCreator
    a sh:PropertyShape ;
    sh:path dcterms:creator ;
    sh:order "4"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:hasValue <https://orcid.org/0009-0000-9657-919X> .

sapsens:DocumentPublisher
    a sh:PropertyShape ;
    sh:path dcterms:publisher ;
    sh:order "5"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:PublisherShape .

sapsens:DocumentVersion
    a sh:PropertyShape ;
    sh:path dcat:version ;
    sh:order "6"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string .

sapsens:DocumentCreated
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:order "7"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:dateTime ;
    sh:description "Compilabile. Il modulo suggerisce data e ora correnti solo se il campo è vuoto; SHACL non genera la data."@it .

sapsens:DocumentModified
    a sh:PropertyShape ;
    sh:path dcterms:modified ;
    sh:order "8"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:dateTime .

sapsens:DocumentConformsTo
    a sh:PropertyShape ;
    sh:path dcterms:conformsTo ;
    sh:order "9"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:hasValue <https://w3id.org/cnr-ismar/sap/sensor/1.0.0/> .

sapsens:DocumentSeeAlso
    a sh:PropertyShape ;
    sh:path rdfs:seeAlso ;
    sh:order "9.1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:hasValue sapsens:profile.ttl ;
    sh:description "Collegamento fisso al file SHACL, aggiunto rispetto all’esempio sorgente."@it .

sapsens:DocumentContact
    a sh:PropertyShape ;
    sh:path dcat:contactPoint ;
    sh:order "27"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:ContactShape .

sapsens:SensorModelShape
    a sh:NodeShape ;
    sh:name "Sensor model"@en ;
    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:IRI ;
    sh:targetClass schema:ProductModel ;
    sh:targetSubjectsOf sosa:hasSubSystem, schema:model ;
    sh:pattern "^https://w3id[.]org/cnr-ismar/sensors-models-registry/[A-Za-z][A-Za-z0-9_-]*$" ;
    sh:property sapsens:ModelTypes, sapsens:ModelRequiredType1, sapsens:ModelRequiredType2, sapsens:ModelRequiredType3, sapsens:ModelManufacturer, sapsens:ModelModel, sapsens:ModelMPN, sapsens:ModelCategory, sapsens:ModelCategoryRecommended, sapsens:ModelLegacyType, sapsens:ModelTitle, sapsens:ModelIdentifier, sapsens:ModelAlternativeIdentifier, sapsens:ModelComment, sapsens:ModelCommentRecommended, sapsens:ModelURL, sapsens:ModelImage, sapsens:ModelReferences, sapsens:ModelMaterial, sapsens:ModelWidth, sapsens:ModelHeight, sapsens:ModelWeight, sapsens:ModelAdditionalValues, sapsens:ModelAdditionalDeviceTypeCount, sapsens:ModelAdditionalTemporaryStorageCount, sapsens:ModelAdditionalDataTypeCount, sapsens:ModelAdditionalOutputDataFormatCount, sapsens:ModelAdditionalLengthCount, sapsens:ModelAdditionalDiameterCount, sapsens:ModelAdditionalElectricalCurrentTypeCount, sapsens:ModelAdditionalInputPowerRangeCount, sapsens:ModelAdditionalOperatingTemperatureCount, sapsens:ModelAdditionalStandardsCount, sapsens:ModelAdditionalSafetyNormCount, sapsens:ModelAdditionalIPCodeCount, sapsens:ModelSubsystems ;
    sh:sparql [
        sh:message "Manca il documento amministrativo con IRI del modello più .ttl."@it ;
        sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS {
    ?doc <http://purl.org/dc/terms/conformsTo> <https://w3id.org/cnr-ismar/sap/sensor/1.0.0/> .
    FILTER(STR(?doc) = CONCAT(STR($this), ".ttl"))
  }
}"""
    ], [
        sh:message "Ogni componente deve dichiarare esplicitamente questo modello come padre."@it ;
        sh:select """SELECT $this ?value WHERE {
  $this <http://www.w3.org/ns/sosa/hasSubSystem> ?value .
  FILTER NOT EXISTS { ?value <http://www.w3.org/ns/sosa/isSubSystemOf> $this }
}"""
    ] .

sapsens:ModelTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:minCount "3"^^xsd:integer ;
    sh:maxCount "3"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( sosa:System schema:ProductModel prov:Entity ) ;
    sh:description "Tipo/i fisso/i e automatico/i; nessuna scelta nel modulo."@it .

sapsens:ModelRequiredType1
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue sosa:System .

sapsens:ModelRequiredType2
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue schema:ProductModel .

sapsens:ModelRequiredType3
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue prov:Entity .

sapsens:ModelManufacturer
    a sh:PropertyShape ;
    sh:path schema:manufacturer ;
    sh:order "10"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:StringOrIRIShape ;
    sh:description "Stringa oppure IRI. Suggerimento: https://vocab.nerc.ac.uk/collection/L35/current/ ."@it .

sapsens:ModelModel
    a sh:PropertyShape ;
    sh:path schema:model ;
    sh:order "11"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string .

sapsens:ModelMPN
    a sh:PropertyShape ;
    sh:path schema:mpn ;
    sh:order "12"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string .

sapsens:ModelCategory
    a sh:PropertyShape ;
    sh:path schema:category ;
    sh:order "13"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:description "Incollare l’IRI del concetto GCMD. Navigazione: https://gcmd.earthdata.nasa.gov/KeywordViewer/ . Controllo del prefisso, senza verifica remota."@it ;
    sh:pattern "^https?://gcmd[.]earthdata[.]nasa[.]gov/kms/concept/.+" .

sapsens:ModelCategoryRecommended
    a sh:PropertyShape ;
    sh:path schema:category ;
    sh:order "13"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:description "È raccomandata una categoria GCMD."@it ;
    sh:severity sh:Warning ;
    sh:message "È raccomandata una categoria GCMD."@it .

sapsens:ModelLegacyType
    a sh:PropertyShape ;
    sh:path dcterms:type ;
    sh:order "14"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:description "Solo NERC P10: https://vocab.nerc.ac.uk/collection/P10/current/ . Collezione storica non più mantenuta; campo facoltativo conservato per scelta del profilo."@it ;
    sh:pattern "^https?://vocab[.]nerc[.]ac[.]uk/collection/P10/.+" .

sapsens:ModelTitle
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:order "15"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "und" ) ;
    sh:maxLength "35"^^xsd:integer .

sapsens:ModelIdentifier
    a sh:PropertyShape ;
    sh:path dcterms:identifier ;
    sh:order "16"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string ;
    sh:description "UUIDv4 semplice generato automaticamente alla creazione e conservato nelle revisioni; senza prefisso urn:uuid:."@it ;
    sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" .

sapsens:ModelAlternativeIdentifier
    a sh:PropertyShape ;
    sh:path adms:identifier ;
    sh:order "17"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:AlternativeIdentifierShape .

sapsens:ModelComment
    a sh:PropertyShape ;
    sh:path rdfs:comment ;
    sh:order "18"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" ) .

sapsens:ModelCommentRecommended
    a sh:PropertyShape ;
    sh:path rdfs:comment ;
    sh:order "18"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:description "È raccomandata una descrizione in inglese."@it ;
    sh:severity sh:Warning ;
    sh:message "È raccomandata una descrizione in inglese."@it .

sapsens:ModelURL
    a sh:PropertyShape ;
    sh:path schema:url ;
    sh:order "19"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://[^/?#\\s]+[^\\s]*$" .

sapsens:ModelImage
    a sh:PropertyShape ;
    sh:path schema:image ;
    sh:order "20"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://[^/?#\\s]+[^\\s]*$" .

sapsens:ModelReferences
    a sh:PropertyShape ;
    sh:path dcterms:references ;
    sh:order "21"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://[^/?#\\s]+[^\\s]*$" .

sapsens:ModelMaterial
    a sh:PropertyShape ;
    sh:path schema:material ;
    sh:order "22"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" ) .

sapsens:ModelWidth
    a sh:PropertyShape ;
    sh:path schema:width ;
    sh:order "23"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:PositiveQuantityShape .

sapsens:ModelHeight
    a sh:PropertyShape ;
    sh:path schema:height ;
    sh:order "24"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:PositiveQuantityShape .

sapsens:ModelWeight
    a sh:PropertyShape ;
    sh:path schema:weight ;
    sh:order "25"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:PositiveQuantityShape .

sapsens:ModelAdditionalValues
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26"^^xsd:decimal ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:description "Sono ammessi soltanto i blocchi elencati, al massimo uno per ciascun schema:name; nessun massimo 1 globale sul collegamento."@it ;
    sh:or ( sapsens:DeviceTypeShape sapsens:TemporaryStorageShape sapsens:DataTypeShape sapsens:OutputDataFormatShape sapsens:LengthShape sapsens:DiameterShape sapsens:ElectricalCurrentTypeShape sapsens:InputPowerRangeShape sapsens:OperatingTemperatureShape sapsens:StandardsShape sapsens:SafetyNormShape sapsens:IPCodeShape ) .

sapsens:ModelAdditionalDeviceTypeCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.01"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "deviceType"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer ;
    sh:qualifiedMinCount "1"^^xsd:integer .

sapsens:ModelAdditionalTemporaryStorageCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.02"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "temporaryStorage"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalDataTypeCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.03"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "dataType"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalOutputDataFormatCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.04"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "outputDataFormat"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalLengthCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.05"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "length"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalDiameterCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.06"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "diameter"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalElectricalCurrentTypeCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.07"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "electricalCurrentType"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalInputPowerRangeCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.08"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "inputPowerRange"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalOperatingTemperatureCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.09"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "operatingTemperature"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalStandardsCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.1"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "standards"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalSafetyNormCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.11"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "safety_norm"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelAdditionalIPCodeCount
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "26.12"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "ipCode"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ModelSubsystems
    a sh:PropertyShape ;
    sh:path sosa:hasSubSystem ;
    sh:order "28"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:node sapsens:SensorComponentShape ;
    sh:description "Almeno un componente sensore; nessun massimo. Ogni componente è descritto nella stessa scheda."@it .

sapsens:PublisherShape
    a sh:NodeShape ;
    sh:name "Publisher"@en ;
    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property sapsens:PublisherTypes, sapsens:PublisherRequiredType1, sapsens:PublisherRequiredType2, sapsens:PublisherRequiredType3, sapsens:PublisherName, sapsens:PublisherSameAs .

sapsens:PublisherTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:minCount "3"^^xsd:integer ;
    sh:maxCount "3"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( prov:Agent prov:Organization foaf:Organization ) ;
    sh:description "Tipo/i fisso/i e automatico/i; nessuna scelta nel modulo."@it .

sapsens:PublisherRequiredType1
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue prov:Agent .

sapsens:PublisherRequiredType2
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue prov:Organization .

sapsens:PublisherRequiredType3
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue foaf:Organization .

sapsens:PublisherName
    a sh:PropertyShape ;
    sh:path foaf:name ;
    sh:order "1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string ;
    sh:hasValue "Istituto di Scienze Marine del Consiglio Nazionale delle Ricerche" .

sapsens:PublisherSameAs
    a sh:PropertyShape ;
    sh:path owl:sameAs ;
    sh:order "2"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:hasValue <https://ror.org/02hdf6119> .

sapsens:AlternativeIdentifierShape
    a sh:NodeShape ;
    sh:name "Alternative identifier"@en ;
    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property sapsens:AlternativeIdentifierTypes, sapsens:AlternativeIdentifierRequiredType1, sapsens:AlternativeNotation .

sapsens:AlternativeIdentifierTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
