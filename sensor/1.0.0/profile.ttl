    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:IRI ;
    sh:targetClass sosa:Sensor ;
    sh:targetObjectsOf sosa:hasSubSystem ;
    sh:targetSubjectsOf sosa:isSubSystemOf ;
    sh:property sapsens:ComponentTypes, sapsens:ComponentRequiredType1, sapsens:ComponentLabel, sapsens:ComponentComment, sapsens:ComponentIdentifier, sapsens:ComponentObserves, sapsens:ComponentParent, sapsens:ComponentUnit, sapsens:ComponentObservationType, sapsens:ComponentMetrologyValues, sapsens:ComponentMetrologyAccuracyCount, sapsens:ComponentMetrologyResolutionCount, sapsens:ComponentMetrologyMeasurementRangeCount ;
    sh:sparql [
        sh:message "Il componente deve essere collegato dal padre tramite sosa:hasSubSystem."@it ;
        sh:select """SELECT $this WHERE {
  $this <http://www.w3.org/ns/sosa/isSubSystemOf> ?parent .
  FILTER NOT EXISTS { ?parent <http://www.w3.org/ns/sosa/hasSubSystem> $this }
}"""
    ], [
        sh:message "IRI del componente non coerente con IRI del padre, trattino e codice locale alfabetico iniziale."@it ;
        sh:select """SELECT $this WHERE {
  $this <http://www.w3.org/ns/sosa/isSubSystemOf> ?parent .
  FILTER(!STRSTARTS(STR($this), CONCAT(STR(?parent), "-")) ||
    !REGEX(SUBSTR(STR($this), STRLEN(STR(?parent)) + 2), "^[A-Za-z][A-Za-z0-9_-]*$"))
}"""
    ] .

sapsens:ComponentTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( sosa:Sensor ) ;
    sh:description "Tipo/i fisso/i e automatico/i; nessuna scelta nel modulo."@it .

sapsens:ComponentRequiredType1
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue sosa:Sensor .

sapsens:ComponentLabel
    a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:order "1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" ) .

sapsens:ComponentComment
    a sh:PropertyShape ;
    sh:path rdfs:comment ;
    sh:order "2"^^xsd:decimal ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" ) .

sapsens:ComponentIdentifier
    a sh:PropertyShape ;
    sh:path dcterms:identifier ;
    sh:order "3"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string .

sapsens:ComponentObserves
    a sh:PropertyShape ;
    sh:path sosa:observes ;
    sh:order "4"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:description "IRI manuale da qualsiasi vocabolario NERC, inclusi /collection/ e /standard_name/. Solo controllo del prefisso http(s)://vocab.nerc.ac.uk/; nessuna verifica remota."@it ;
    sh:pattern "^https?://vocab[.]nerc[.]ac[.]uk/.+" .

sapsens:ComponentParent
    a sh:PropertyShape ;
    sh:path sosa:isSubSystemOf ;
    sh:order "5"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:description "IRI del modello padre, generata automaticamente e dichiarata esplicitamente."@it .

sapsens:ComponentUnit
    a sh:PropertyShape ;
    sh:path schema:unitCode ;
    sh:order "6"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:ScientificUnitShape ;
    sh:description "Incollare l’IRI dell’unità da https://qudt.org/doc/DOC_VOCAB-UNITS.html oppure https://vocab.nerc.ac.uk/collection/P06/current/ . Solo controllo del prefisso, senza verifica del termine nel catalogo."@it .

sapsens:ComponentObservationType
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:order "7"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:ObservationTypeShape .

sapsens:ComponentMetrologyValues
    a sh:PropertyShape ;
    sh:path sosa:hasProperty ;
    sh:order "8"^^xsd:decimal ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:description "Sono ammessi soltanto i blocchi elencati, al massimo uno per ciascun schema:name; nessun massimo 1 globale sul collegamento."@it ;
    sh:or ( sapsens:AccuracyShape sapsens:ResolutionShape sapsens:MeasurementRangeShape ) .

sapsens:ComponentMetrologyAccuracyCount
    a sh:PropertyShape ;
    sh:path sosa:hasProperty ;
    sh:order "8.01"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "accuracy"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ComponentMetrologyResolutionCount
    a sh:PropertyShape ;
    sh:path sosa:hasProperty ;
    sh:order "8.02"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "resolution"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ComponentMetrologyMeasurementRangeCount
    a sh:PropertyShape ;
    sh:path sosa:hasProperty ;
    sh:order "8.03"^^xsd:decimal ;
    sh:qualifiedValueShape [
        sh:property [
            sh:path schema:name ;
            sh:hasValue "measurement range"
        ]
    ] ;
    sh:qualifiedMaxCount "1"^^xsd:integer .

sapsens:ObservationTypeShape
    a sh:NodeShape ;
    sh:name "Observation type"@en ;
    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property sapsens:ObservationTypeTypes, sapsens:ObservationTypeRequiredType1, sapsens:ObservationTypeName, sapsens:ObservationTypeValue .

sapsens:ObservationTypeTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( schema:PropertyValue ) ;
    sh:description "Tipo/i fisso/i e automatico/i; nessuna scelta nel modulo."@it .

sapsens:ObservationTypeRequiredType1
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue schema:PropertyValue .

sapsens:ObservationTypeName
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:order "1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string ;
    sh:hasValue "observationType" .

sapsens:ObservationTypeValue
    a sh:PropertyShape ;
    sh:path schema:value ;
    sh:order "2"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( omtype:OM_Measurement omtype:OM_CountObservation omtype:OM_CategoryObservation omtype:OM_TruthObservation omtype:OM_Observation ) ;
    sh:description "Menu con le cinque IRI OGC concordate. L’unità del componente resta obbligatoria per tutti i tipi."@it .

sapsens:AccuracyShape
    a sh:NodeShape ;
    sh:name "accuracy"@en ;
    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property sapsens:AccuracyTypes, sapsens:AccuracyRequiredType1, sapsens:AccuracyRequiredType2, sapsens:AccuracyLabel, sapsens:AccuracyName, sapsens:AccuracyValue, sapsens:AccuracyUnit .

sapsens:AccuracyTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:minCount "2"^^xsd:integer ;
    sh:maxCount "2"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( sosa:Property schema:PropertyValue ) ;
    sh:description "Tipo/i fisso/i e automatico/i; nessuna scelta nel modulo."@it .

sapsens:AccuracyRequiredType1
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue sosa:Property .

sapsens:AccuracyRequiredType2
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue schema:PropertyValue .

sapsens:AccuracyLabel
    a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:order "1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:hasValue "Accuracy"@en ;
    sh:languageIn ( "en" ) .

sapsens:AccuracyName
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:order "2"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string ;
    sh:hasValue "accuracy" .

sapsens:AccuracyValue
    a sh:PropertyShape ;
    sh:path schema:value ;
    sh:order "3"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:NumberShape .

sapsens:AccuracyUnit
    a sh:PropertyShape ;
    sh:path schema:unitCode ;
    sh:order "4"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:ScientificUnitShape ;
    sh:description "Incollare l’IRI dell’unità da https://qudt.org/doc/DOC_VOCAB-UNITS.html oppure https://vocab.nerc.ac.uk/collection/P06/current/ . Solo controllo del prefisso, senza verifica del termine nel catalogo."@it .

sapsens:ResolutionShape
    a sh:NodeShape ;
    sh:name "resolution"@en ;
    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property sapsens:ResolutionTypes, sapsens:ResolutionRequiredType1, sapsens:ResolutionRequiredType2, sapsens:ResolutionLabel, sapsens:ResolutionName, sapsens:ResolutionValue, sapsens:ResolutionUnit .

sapsens:ResolutionTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:minCount "2"^^xsd:integer ;
    sh:maxCount "2"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( sosa:Property schema:PropertyValue ) ;
    sh:description "Tipo/i fisso/i e automatico/i; nessuna scelta nel modulo."@it .

sapsens:ResolutionRequiredType1
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue sosa:Property .

sapsens:ResolutionRequiredType2
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue schema:PropertyValue .

sapsens:ResolutionLabel
    a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:order "1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:hasValue "Resolution"@en ;
    sh:languageIn ( "en" ) .

sapsens:ResolutionName
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:order "2"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string ;
    sh:hasValue "resolution" .

sapsens:ResolutionValue
    a sh:PropertyShape ;
    sh:path schema:value ;
    sh:order "3"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:NumberShape ;
    sh:minExclusive "0"^^xsd:integer .

sapsens:ResolutionUnit
    a sh:PropertyShape ;
    sh:path schema:unitCode ;
    sh:order "4"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:ScientificUnitShape ;
    sh:description "Incollare l’IRI dell’unità da https://qudt.org/doc/DOC_VOCAB-UNITS.html oppure https://vocab.nerc.ac.uk/collection/P06/current/ . Solo controllo del prefisso, senza verifica del termine nel catalogo."@it .

sapsens:MeasurementRangeShape
    a sh:NodeShape ;
    sh:name "measurement range"@en ;
    sh:closed "true"^^xsd:boolean ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property sapsens:MeasurementRangeTypes, sapsens:MeasurementRangeRequiredType1, sapsens:MeasurementRangeRequiredType2, sapsens:MeasurementRangeLabel, sapsens:MeasurementRangeName, sapsens:MeasurementRangeMinimum, sapsens:MeasurementRangeMaximum, sapsens:MeasurementRangeUnit .

sapsens:MeasurementRangeTypes
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:minCount "2"^^xsd:integer ;
    sh:maxCount "2"^^xsd:integer ;
    sh:nodeKind sh:IRI ;
    sh:in ( sosa:Property schema:PropertyValue ) ;
    sh:description "Tipo/i fisso/i e automatico/i; nessuna scelta nel modulo."@it .

sapsens:MeasurementRangeRequiredType1
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue sosa:Property .

sapsens:MeasurementRangeRequiredType2
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:order "0"^^xsd:decimal ;
    sh:hasValue schema:PropertyValue .

sapsens:MeasurementRangeLabel
    a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:order "1"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype rdf:langString ;
    sh:hasValue "Measurement range"@en ;
    sh:languageIn ( "en" ) .

sapsens:MeasurementRangeName
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:order "2"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:datatype xsd:string ;
    sh:hasValue "measurement range" .

sapsens:MeasurementRangeMinimum
    a sh:PropertyShape ;
    sh:path schema:minValue ;
    sh:order "3"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:NumberShape ;
    sh:lessThanOrEquals schema:maxValue .

sapsens:MeasurementRangeMaximum
    a sh:PropertyShape ;
    sh:path schema:maxValue ;
    sh:order "4"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:NumberShape .

sapsens:MeasurementRangeUnit
    a sh:PropertyShape ;
    sh:path schema:unitCode ;
    sh:order "5"^^xsd:decimal ;
    sh:minCount "1"^^xsd:integer ;
    sh:maxCount "1"^^xsd:integer ;
    sh:node sapsens:ScientificUnitShape ;
    sh:description "Incollare l’IRI dell’unità da https://qudt.org/doc/DOC_VOCAB-UNITS.html oppure https://vocab.nerc.ac.uk/collection/P06/current/ . Solo controllo del prefisso, senza verifica del termine nel catalogo."@it .

sapsens:NumberShape
    a sh:NodeShape ;
    sh:name "RDF numeric literal"@en ;
    sh:nodeKind sh:Literal ;
    sh:or ( [
            sh:datatype xsd:decimal
        ] [
            sh:datatype xsd:integer
        ] [
            sh:datatype xsd:double
        ] [
            sh:datatype xsd:float
        ] [
            sh:datatype xsd:nonPositiveInteger
        ] [
            sh:datatype xsd:negativeInteger
        ] [
            sh:datatype xsd:long
        ] [
            sh:datatype xsd:int
        ] [
            sh:datatype xsd:short
        ] [
            sh:datatype xsd:byte
        ] [
            sh:datatype xsd:nonNegativeInteger
        ] [
            sh:datatype xsd:unsignedLong
        ] [
            sh:datatype xsd:unsignedInt
        ] [
            sh:datatype xsd:unsignedShort
        ] [
            sh:datatype xsd:unsignedByte
        ] [
            sh:datatype xsd:positiveInteger
        ] ) .

sapsens:StringOrIRIShape
    a sh:NodeShape ;
    sh:name "Plain string or IRI"@en ;
    sh:or ( [
            sh:datatype xsd:string
        ] [
            sh:nodeKind sh:IRI
        ] ) .

sapsens:TextOrHttpIRIShape
    a sh:NodeShape ;
    sh:name "Plain string or HTTP(S) IRI"@en ;
    sh:or ( [
            sh:datatype xsd:string
        ] [
            sh:nodeKind sh:IRI ;
            sh:pattern "^https?://[^/?#\\s]+[^\\s]*$"
        ] ) .

sapsens:ScientificUnitShape
    a sh:NodeShape ;
    sh:name "QUDT or NERC P06 unit IRI"@en ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://(qudt[.]org/vocab/unit/|vocab[.]nerc[.]ac[.]uk/collection/P06/).+" ;
    sh:description "Incollare l’IRI dell’unità da https://qudt.org/doc/DOC_VOCAB-UNITS.html oppure https://vocab.nerc.ac.uk/collection/P06/current/ . Solo controllo del prefisso, senza verifica del termine nel catalogo."@it .

sapsens:RecordGraphShape
    a sh:NodeShape ;
    sh:name "Record graph presence"@en ;
    sh:targetNode sapsens:profile.ttl ;
    sh:sparql [
        sh:message "Il grafo deve contenere almeno un modello schema:ProductModel."@it ;
        sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS { ?model a <http://schema.org/ProductModel> }
}"""
    ] .
