###############################################################################
# CNR ISMAR - Feature of Interest Application Profile 1.0.0
# Active profile and SHACL constraints in a single Turtle document.
###############################################################################
# Feature of Interest: https://w3id.org/cnr-ismar/features-of-interest-registry/{ID}
# Document: the Feature of Interest IRI followed by .ttl (local profile convention).
# Geometry: https://w3id.org/cnr-ismar/features-of-interest-registry/{ID}.ttl#geometry-{UUID}
# Geometry (abbreviated Turtle): foireg:{ID}.ttl\#geometry-{UUID}
#
# FeatureOfInterestShape validates the Feature identifiers, names, description,
# depiction, accuracy
# and exactly one Geometry. Names are generated as identical English
# rdfs:label, skos:prefLabel and dcterms:title values from the selected context.
# UUID v4 and compact notation constraints remain unchanged.
# MetadataDocumentShape validates the separate document header: fixed license,
# creator, contact, publisher, rights and access, plus document version, dates and profile conformance.
# The document version is independent of the profile version. Dates concern the
# document, not the physical feature of interest. The rights literal retains its trailing
# space. A single authorized SPARQL presence check requires each Feature of Interest header.
# GeometryShape retains the UUID, reciprocal ownership and WKT constraints.
# EPSG:4979 WKT order: longitude, latitude, ellipsoidal height, in POINT Z form.
# Cardinalities and fixed values are profile rules, not vocabulary requirements.
# Previous separate profile/shape documents remain in .shacl/archived/.
###############################################################################

@prefix foireg:    <https://w3id.org/cnr-ismar/features-of-interest-registry/> .
@prefix sapfoi:    <https://w3id.org/cnr-ismar/sap/featureOfInterest/1.0.0/> .
@prefix foishape:  <https://w3id.org/cnr-ismar/sap/featureOfInterest/1.0.0/profile.ttl#> .
@prefix prof:      <http://www.w3.org/ns/dx/prof/> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix dcat:      <http://www.w3.org/ns/dcat#> .
@prefix vcard:     <http://www.w3.org/2006/vcard/ns#> .
@prefix orcid:     <https://orcid.org/> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix foaf:      <http://xmlns.com/foaf/0.1/> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix sosa:      <http://www.w3.org/ns/sosa/> .
@prefix geo:       <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

###############################################################################
# 2. PROFILE
###############################################################################

sapfoi:
    a prof:Profile ;
    dcterms:title "CNR ISMAR Semantic Application Profile for Features of Interest"@en ;
    dcterms:description "Application profile for describing features of interest as SOSA Features of Interest and GeoSPARQL Features with associated WKT geometries and separate document-level administrative metadata."@en ;
    dcterms:identifier "cnr-ismar-sap-feature-of-interest-1.0.0" ;
    # Version indicator for this semantic profile
    dcat:version "1.0.0" ;
    dcterms:issued "2026-11-02"^^xsd:date ;
    dcterms:publisher [
        a prov:Agent, prov:Organization, foaf:Organization ;
        foaf:name "Istituto di Scienze Marine del Consiglio Nazionale delle Ricerche" ;
        owl:sameAs <https://ror.org/02hdf6119>
    ] ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator orcid:0009-0000-9657-919X ;
    dcat:contactPoint [
        a vcard:Individual ;
        vcard:fn "Federico Bellati" ;
        vcard:hasEmail <mailto:federico.bellati@cnr.it>
    ] ;

    dcterms:conformsTo <https://www.w3.org/TR/shacl/> ;
    dcterms:conformsTo <https://www.ogc.org/standards/geosparql/> ;

    dcterms:hasPart foishape:FeatureOfInterestShape, foishape:GeometryShape, foishape:MetadataDocumentShape .

###############################################################################
# 3. SHACL VALIDATION RULES
###############################################################################

###############################################################################
# Feature of Interest shape
###############################################################################

foishape:FeatureOfInterestShape
    a sh:NodeShape ;
    dcterms:isPartOf sapfoi: ;

    sh:name "Feature of Interest"@en ;
    sh:description """
A feature of interest typed as sosa:FeatureOfInterest and geo:Feature.

According to this application profile, a Feature of Interest resource must be identified
by an IRI following this pattern:

https://w3id.org/cnr-ismar/features-of-interest-registry/{ID}

The local identifier {ID} is generated as
{Environment}_{Compartment}_{SiteLabel}{Sign}{Value}.
Environment is Ocean, Sea, Coast, Lagoon, River, Estuary, Lake, Marshland, Glacier or Atmosphere.
For the nine water environments, Compartment is Surface_WT, Subsurface_WT, Deep_WT,
Bottom_WT or WT_Column: only the word Water is abbreviated to WT.
For Atmosphere, Compartment is Near-surface_Air, Atmospheric_Boundary_Layer,
Free_Troposphere or Atmospheric_Column. Water and atmospheric options must not be mixed.
These are operational categories, not mutually exclusive vertical layers.
Near-surface Air is a local display label based on WMO OSCAR Near Surface,
full name At the surface (in the air): https://space.oscar.wmo.int/layers.
No autonomous RDF concept IRI for this OSCAR layer has been verified.
Atmospheric Boundary Layer refers to the accepted SeaVoX L13 concept
http://vocab.nerc.ac.uk/collection/L13/current/AB/.
Free Troposphere refers to the stable WMO concept
http://codes.wmo.int/wmdr/ObservedLayer/freeTroposphere.
Atmospheric Column is a local display label informed by the accepted NERC P38 concept
http://vocab.nerc.ac.uk/collection/P38/current/atmosphere_layer/.
That concept describes a vertically bounded layer; this profile retains POINT Z
and does not encode its vertical extent. Use the description to explain the observed portion.
Site Label is mandatory free English text of at least three characters after
trimming. The form removes diacritics, replaces runs of spaces or symbols with
underscores and removes boundary underscores; the resulting SiteLabel must
also contain at least three characters. It is recovered from the IRI on import
and is not emitted as an additional RDF property.
The suffix directly follows SiteLabel, without an underscore or a Z prefix.
Sign is P for positive values or zero, and N for negative values; Value is the
absolute geometry Z value in metres, with D replacing the decimal point and
without redundant leading or trailing zeroes. Zero is P0, including negative zero.
For example: Lagoon_Bottom_WT_Venice_NorthN10D5 for geometry Z = -10.5.
The suffix copies the existing ellipsoidal height; it does not convert it to
depth below the water surface or change the geometry's vertical reference.
The descriptive local identifier has no 35-character limit.

A feature of interest must provide a single automatically generated human-readable
name expressed as rdfs:label, skos:prefLabel and dcterms:title. All three values
must be identical, use the English language tag @en and be at least three
characters long. The reference form uses the following space-separated order:

{Compartment} {Environment} {ExtendedSiteLabel} {SignedValue} m

The compartment and environment are written in full, including Water rather than WT.
Extended Site Label is mandatory non-empty free English text; ordinary characters
and internal spaces are preserved. SignedValue copies the geometry Z value in
metres, using + for positive values and zero, - for negatives and a decimal point.
For example: Bottom Water Lagoon Venice North -10.5 m.
This copies the current ellipsoidal height without changing the vertical reference.
Extended Site Label is recovered from the generated name on import, not emitted
as an additional RDF property, and does not affect the local identifier or notation.

A feature of interest must provide exactly one English textual description using
dcterms:description with language tag @en.

A preferred label is the same generated English name, provided as skos:prefLabel.

A feature of interest must provide exactly one system-generated alternative identifier
using skos:notation. This identifier is intended for systems requiring compact
alphanumeric identifiers, such as SensorThings API / FROST Server
implementations. It must be expressed as xsd:string, must contain at most
35 characters, and may contain only letters, numbers and underscores.
The reference form always abbreviates the environment and compartment in
skos:notation, retaining WT for Water. Environment codes are Ocean OC, Sea SE,
Coast CO, Lagoon LG, River RI, Estuary ES, Lake LK, Marshland MA, Glacier GL and Atmosphere AT.
Compartment codes are Surface_WT SWT, Subsurface_WT SSWT, Deep_WT DWT,
Bottom_WT BWT, WT_Column WTC, Near-surface_Air NSA, Atmospheric_Boundary_Layer ABL,
Free_Troposphere FT and Atmospheric_Column ATC. SiteLabel and the numeric suffix remain intact.
These are local identifier conventions, not ontology terms. The descriptive
identifier and Feature IRI are unchanged. The generated notation follows edits
to the descriptive identifier and does not depend on the Feature's UUID.
If the abbreviated notation still exceeds 35 characters, the form blocks
export until Site Label is shortened or a valid custom notation is supplied.

A feature of interest must provide exactly one system-generated UUID version 4 identifier
using dcterms:identifier. The UUID must be expressed as xsd:string using the
canonical UUID textual representation.

A feature of interest must have exactly one associated GeoSPARQL Geometry.

Administrative metadata belongs to a separate document resource whose IRI is
the Feature of Interest IRI followed by .ttl. MetadataDocumentShape validates its license,
creator, contact, publisher, rights, access rights, document version and dates.
The document and Feature of Interest IRIs are distinct; the .ttl suffix is a local profile
convention, not a requirement of the external vocabularies.

The geometry is expected to be encoded as a three-dimensional WKT geometry
using EPSG:4979, where coordinates are expressed as longitude, latitude and
ellipsoidal height. Longitude and latitude are expressed in decimal degrees
and elevation is expressed in metres.
"""@en ;

    ###########################################################################
    # Target
    ###########################################################################

    sh:targetClass sosa:FeatureOfInterest, geo:Feature ;

    # Authorized presence check: each Feature needs its own document header.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The Feature of Interest must have a separate metadata document at its IRI followed by .ttl in the same data graph."@en ;
        sh:select """
            PREFIX dcterms: <http://purl.org/dc/terms/>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    BIND(IRI(CONCAT(STR($this), ".ttl")) AS ?document)
                    ?document dcterms:license ?license .
                }
            }
        """ ;
    ] ;

    ###########################################################################
    # Feature of Interest IRI
    ###########################################################################

    sh:nodeKind sh:IRI ;
    sh:pattern "^https://w3id\\.org/cnr-ismar/features-of-interest-registry/((Ocean|Sea|Coast|Lagoon|River|Estuary|Lake|Marshland|Glacier)_(Surface_WT|Subsurface_WT|Deep_WT|Bottom_WT|WT_Column)|Atmosphere_(Near-surface_Air|Atmospheric_Boundary_Layer|Free_Troposphere|Atmospheric_Column))_[A-Za-z0-9][A-Za-z0-9_]+[A-Za-z0-9][PN](0|[1-9][0-9]*)(D[0-9]*[1-9])?$" ;
    sh:message "The Feature of Interest IRI must use {Environment}_{Compartment}_{SiteLabel}{Sign}{Value}, with Water abbreviated only to WT, a normalized SiteLabel of at least three characters and a P/N suffix encoding geometry Z with D for decimals."@en ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The final P/N numeric suffix of the Feature of Interest IRI must match its geometry's Z value; zero must be encoded as P0."@en ;
        sh:select """
            PREFIX geo: <http://www.opengis.net/ont/geosparql#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this geo:hasGeometry/geo:asWKT ?wkt .
                BIND(REPLACE(STR($this), "^.*([PN])([0-9]+(D[0-9]+)?)$", "$1$2") AS ?suffix)
                BIND(xsd:decimal(REPLACE(SUBSTR(?suffix, 2), "D", ".")) AS ?magnitude)
                BIND(IF(STRSTARTS(?suffix, "N"), -?magnitude, ?magnitude) AS ?encodedZ)
                BIND(xsd:decimal(REPLACE(STR(?wkt), "^.*\\\\s([^\\\\s)]+)\\\\s*[)]$", "$1", "s")) AS ?geometryZ)
                FILTER (!BOUND(?encodedZ) || !BOUND(?geometryZ) || ?encodedZ != ?geometryZ || ?suffix = "N0")
            }
        """ ;
    ] ;

    ###########################################################################
    # Generated name context and vertical value
    ###########################################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The generated name must start with the owning Feature's full compartment and environment, and its final signed value in metres must match geometry Z."@en ;
        sh:select """
            PREFIX geo: <http://www.opengis.net/ont/geosparql#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this rdfs:label ?name ; geo:hasGeometry/geo:asWKT ?wkt .
                BIND(STRAFTER(STR($this), "https://w3id.org/cnr-ismar/features-of-interest-registry/") AS ?local)
                BIND(STRBEFORE(?local, "_") AS ?waterBody)
                BIND(REPLACE(?local, "^[^_]+_((Surface|Subsurface|Deep|Bottom)_WT|WT_Column|Near-surface_Air|Atmospheric_Boundary_Layer|Free_Troposphere|Atmospheric_Column)_.*$", "$1") AS ?compartment)
                BIND(CONCAT(REPLACE(REPLACE(?compartment, "WT", "Water"), "_", " "), " ", ?waterBody, " ") AS ?prefix)
                BIND(xsd:decimal(REPLACE(STR(?name), "^.* ([-+][0-9]+([.][0-9]+)?) m$", "$1")) AS ?nameZ)
                BIND(xsd:decimal(REPLACE(STR(?wkt), "^.*\\\\s([^\\\\s)]+)\\\\s*[)]$", "$1", "s")) AS ?geometryZ)
                FILTER (!STRSTARTS(STR(?name), ?prefix) || !BOUND(?nameZ) || !BOUND(?geometryZ) || ?nameZ != ?geometryZ)
            }
        """ ;
    ] ;

    ###########################################################################
    # rdf:type geo:Feature
    ###########################################################################

    sh:property [
        sh:path rdf:type ;
        sh:name "Resource type"@en ;
        sh:description "The resource must be explicitly typed as a GeoSPARQL Feature."@en ;
        sh:order 1 ;
        sh:hasValue geo:Feature ;
        sh:message "A feature of interest must be explicitly typed as geo:Feature."@en ;
    ] ;

    sh:property [ sh:path rdf:type ; sh:hasValue sosa:FeatureOfInterest ; sh:name "Feature of interest type"@en ; sh:message "The resource must be explicitly typed as sosa:FeatureOfInterest."@en ] ;

    ###########################################################################
    # skos:notation
    ###########################################################################

    sh:property [
        sh:path skos:notation ;
        sh:name "Alternative system identifier"@en ;
        sh:description "Readable dissemination identifier always using local environment and observed compartment codes only in this notation, with WT retained for Water. SiteLabel and the numeric suffix are never truncated. If the result exceeds 35 characters, shorten Site Label or supply a valid custom notation. The value must be expressed as xsd:string, must contain at most 35 characters, and may contain only ASCII letters, numbers and underscores. Use as a FROST entity ID requires STRING ID configuration; an ERDDAP datasetID must start with a letter."@en ;
        sh:order 2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:maxLength 35 ;
        sh:pattern "^[A-Za-z0-9_]{1,35}$" ;
        sh:message "A feature of interest must have exactly one skos:notation value expressed as xsd:string. The value must contain at most 35 characters and may contain only letters, numbers and underscores."@en ;
    ] ;

    ###########################################################################
    # dcterms:identifier
    ###########################################################################

    sh:property [
        sh:path dcterms:identifier ;
        sh:name "UUID v4 identifier"@en ;
        sh:description "Mandatory system-generated UUID version 4 identifier for the feature of interest. The value must be expressed as xsd:string using the canonical UUID textual representation."@en ;
        sh:order 3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" ;
        sh:message "A feature of interest must have exactly one dcterms:identifier value containing a valid UUID version 4 expressed as xsd:string."@en ;
    ] ;

    ###########################################################################
    # rdfs:label
    ###########################################################################

    sh:property [
        sh:path rdfs:label ;
        sh:name "Name"@en ;
        sh:description "Name generated from the full observed compartment, full environment, Extended Site Label and signed geometry Z value in metres, separated by spaces. Emitted as rdfs:label @en, identical to skos:prefLabel and dcterms:title, with at least three characters."@en ;
        sh:order 4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" ) ;
        sh:minLength 3 ;
        sh:equals dcterms:title ;
        sh:message "A feature of interest must have exactly one rdfs:label using @en, at least three characters long, and identical to dcterms:title."@en ;
    ] ;

    ###########################################################################
    # skos:prefLabel
    ###########################################################################

    sh:property [
        sh:path skos:prefLabel ;
        sh:name "Preferred name"@en ;
        sh:description "Preferred name generated from the full observed compartment, full environment, Extended Site Label and signed geometry Z value followed by m, separated by spaces. It must be a single @en literal identical to rdfs:label and dcterms:title."@en ;
        sh:order 5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" ) ;
        sh:minLength 3 ;
        sh:equals rdfs:label ;
        sh:pattern "^((Surface Water|Subsurface Water|Deep Water|Bottom Water|Water Column) (Ocean|Sea|Coast|Lagoon|River|Estuary|Lake|Marshland|Glacier)|(Near-surface Air|Atmospheric Boundary Layer|Free Troposphere|Atmospheric Column) Atmosphere) .*\\S.* [-+][0-9]+([.][0-9]+)? m$" ;
        sh:message "A feature of interest must have exactly one skos:prefLabel @en, identical to rdfs:label and dcterms:title, generated as full compartment, full environment, non-empty Extended Site Label and signed geometry Z value in metres."@en ;
    ] ;

    ###########################################################################
    # dcterms:title
    ###########################################################################

    sh:property [
        sh:path dcterms:title ;
        sh:name "Title"@en ;
        sh:description "Title generated from the full observed compartment, full environment, Extended Site Label and signed geometry Z value in metres, separated by spaces. Emitted as dcterms:title @en, identical to rdfs:label and skos:prefLabel, with at least three characters."@en ;
        sh:order 6 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" ) ;
        sh:minLength 3 ;
        sh:equals rdfs:label ;
        sh:message "A feature of interest must have exactly one dcterms:title using @en, at least three characters long, and identical to rdfs:label."@en ;
    ] ;

    ###########################################################################
    # dcterms:description
    ###########################################################################

    sh:property [
        sh:path dcterms:description ;
        sh:name "Description"@en ;
        sh:description "Textual description of the feature of interest. It is emitted by the reference form as dcterms:description with language tag @en and must contain at least three characters."@en ;
        sh:order 7 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" ) ;
        sh:minLength 3 ;
        sh:message "A feature of interest must have exactly one dcterms:description using @en and containing at least three characters."@en ;
    ] ;

    ###########################################################################
    # foaf:depiction
    ###########################################################################

    sh:property [
        sh:path foaf:depiction ;
        sh:name "Depiction"@en ;
        sh:description "Required HTTP or HTTPS URI of an image depicting the feature of interest; the form selects the registry AVIF image from the environment and observed compartment."@en ;
        sh:order 12 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https?://[^\\s<>\"']+$" ;
        sh:flags "i" ;
        sh:message "Exactly one foaf:depiction is required and must be an HTTP or HTTPS URI of an image, without spaces, angle brackets or quotes."@en ;
    ] ;

    ###########################################################################
    # geo:hasMetricSpatialAccuracy
    ###########################################################################

    sh:property [
        sh:path geo:hasMetricSpatialAccuracy ;
        sh:name "Vertical accuracy"@en ;
        sh:description "In this profile, this mandatory field records only the vertical accuracy of the ellipsoidal height (the Z coordinate in POINT Z), not the accuracy of longitude or latitude. Express the value in metres as a non-negative number. The reference form emits this value as xsd:double."@en ;
        sh:order 13 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:integer ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
        ) ;
        sh:minInclusive 0 ;
        sh:message "Vertical accuracy is mandatory and must be a non-negative numeric value expressed in metres, referring only to the ellipsoidal height."@en ;
    ] ;

    ###########################################################################
    # geo:hasGeometry
    ###########################################################################

    sh:property [
        sh:path geo:hasGeometry ;
        sh:name "Geometry"@en ;
        sh:description "The single GeoSPARQL geometry associated with the feature of interest. The geometry must be an IRI, must be explicitly typed as geo:Geometry, and must conform to GeometryShape."@en ;
        sh:order 14 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class geo:Geometry ;
        sh:node foishape:GeometryShape ;
        sh:message "A feature of interest must have exactly one geo:hasGeometry value. The geometry must be an IRI, must be typed as geo:Geometry and must conform to GeometryShape."@en ;
    ] .


###############################################################################
# Metadata document shape
###############################################################################

foishape:MetadataDocumentShape
    a sh:NodeShape ;
    dcterms:isPartOf sapfoi: ;
    sh:name "Metadata document"@en ;
    sh:description "Administrative metadata about the Turtle document describing one Feature of Interest, including conformance to this application profile. The document IRI is the Feature of Interest IRI followed by .ttl. The document has no additional explicit RDF class or document-to-Feature of Interest predicate, following the RI profile pattern."@en ;
    sh:targetSubjectsOf dcterms:license, dcterms:creator, dcat:contactPoint, dcterms:publisher, dcterms:rights, dcterms:accessRights, dcat:version, dcterms:created, dcterms:modified ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://w3id[.]org/cnr-ismar/features-of-interest-registry/[A-Za-z0-9][A-Za-z0-9_-]*[.]ttl$" ;
    sh:not [ sh:class geo:Feature ] ;
    sh:message "Administrative metadata must belong to a separate document IRI following https://w3id.org/cnr-ismar/features-of-interest-registry/{ID}.ttl, not to the Feature of Interest or Geometry."@en ;

    ###########################################################################
    # dcterms:license
    ###########################################################################

    sh:property [
        sh:path dcterms:license ;
        sh:name "License"@en ;
        sh:description "Mandatory license: exactly the Creative Commons Attribution 4.0 International (CC BY 4.0) IRI."@en ;
        sh:order 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue <https://creativecommons.org/licenses/by/4.0/> ;
        sh:message "A metadata document must have exactly one dcterms:license: <https://creativecommons.org/licenses/by/4.0/>."@en ;
    ] ;

    ###########################################################################
    # dcterms:creator and dcat:contactPoint - mandatory fixed values
    ###########################################################################

    sh:property [
        sh:path dcterms:creator ;
        sh:name "Creator"@en ;
        sh:description "Mandatory fixed creator: Federico Bellati, identified by the ORCID IRI."@en ;
        sh:order 2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue orcid:0009-0000-9657-919X ;
        sh:message "A metadata document must have exactly one dcterms:creator: <https://orcid.org/0009-0000-9657-919X>."@en ;
    ] ;

    sh:property [
        sh:path dcat:contactPoint ;
        sh:name "Contact point"@en ;
        sh:description "Mandatory fixed contact, described as vcard:Individual with the exact name Federico Bellati and email IRI mailto:federico.bellati@cnr.it."@en ;
        sh:order 3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue vcard:Individual ;
                sh:message "The contact point must be explicitly typed as vcard:Individual."@en ;
            ] ;
            sh:property [
                sh:path vcard:fn ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:string ;
                sh:hasValue "Federico Bellati" ;
                sh:message "The contact point must have exactly one untagged vcard:fn: Federico Bellati."@en ;
            ] ;
            sh:property [
                sh:path vcard:hasEmail ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:hasValue <mailto:federico.bellati@cnr.it> ;
                sh:message "The contact point must have exactly one vcard:hasEmail: <mailto:federico.bellati@cnr.it>."@en ;
            ] ;
        ] ;
        sh:message "A metadata document must have exactly one contact point with the required type, name and email."@en ;
    ] ;

    ###########################################################################
    # dcterms:publisher - required organization description
    ###########################################################################

    sh:property [
        sh:path dcterms:publisher ;
        sh:name "Publisher"@en ;
        sh:description "Mandatory CNR ISMAR publisher, identified by a blank node or IRI and described with the required explicit types, exact name and ROR link."@en ;
        sh:order 4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue prov:Agent ;
                sh:message "The publisher must be explicitly typed as prov:Agent."@en ;
            ] ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue prov:Organization ;
                sh:message "The publisher must be explicitly typed as prov:Organization."@en ;
            ] ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue foaf:Organization ;
                sh:message "The publisher must be explicitly typed as foaf:Organization."@en ;
            ] ;
            sh:property [
                sh:path foaf:name ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:string ;
                sh:hasValue "Istituto di Scienze Marine del Consiglio Nazionale delle Ricerche" ;
                sh:message "The publisher must have exactly the untagged foaf:name 'Istituto di Scienze Marine del Consiglio Nazionale delle Ricerche'."@en ;
            ] ;
            sh:property [
                sh:path owl:sameAs ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:hasValue <https://ror.org/02hdf6119> ;
                sh:message "The publisher must include owl:sameAs <https://ror.org/02hdf6119>; all owl:sameAs values must be IRIs."@en ;
            ] ;
        ] ;
        sh:message "A metadata document must have exactly one publisher described as the CNR ISMAR organization, with all required types, name and ROR link."@en ;
    ] ;

    ###########################################################################
    # dcterms:rights and dcterms:accessRights - mandatory fixed values
    ###########################################################################

    sh:property [
        sh:path dcterms:rights ;
        sh:name "Rights"@en ;
        sh:description "Mandatory fixed English rights statement clarifying that the license applies only to this metadata record. The trailing space is part of the required literal."@en ;
        sh:order 5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" ) ;
        sh:hasValue "The licence (dcterms:license) applies to this metadata record only; "@en ;
        sh:message "A metadata document must have exactly one dcterms:rights: the fixed English metadata-only license statement, including its trailing space."@en ;
    ] ;

    sh:property [
        sh:path dcterms:accessRights ;
        sh:name "Access rights"@en ;
        sh:description "Mandatory public access: exactly the PUBLIC IRI from the EU Access right authority table."@en ;
        sh:order 6 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        sh:message "A metadata document must have exactly one dcterms:accessRights: <http://publications.europa.eu/resource/authority/access-right/PUBLIC>."@en ;
    ] ;

    sh:property [ sh:path dcat:version ; sh:name "Document version"@en ; sh:description "The editable version of this metadata document, independent of the semantic application profile version. The form starts at 1.0.0."@en ; sh:order 7 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:pattern "\\S" ] ;

    # Dates of the feature of interest instance document, recorded on the separate document resource.
    sh:property [
        sh:path dcterms:created ;
        sh:name "Feature of Interest instance document creation date"@en ;
        sh:description "The date and time the feature of interest instance document was created. This is metadata about the instance document, not the semantic application profile or the physical feature of interest."@en ;
        sh:order 8 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "The feature of interest instance document must have exactly one dcterms:created value typed as xsd:dateTime."@en ;
    ] ;

    sh:property [
        sh:path dcterms:modified ;
        sh:name "Feature of Interest instance document modification date"@en ;
        sh:description "The date and time the feature of interest instance document was last modified. This is metadata about the instance document, not the semantic application profile or the physical feature of interest."@en ;
        sh:order 9 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "The feature of interest instance document must have exactly one dcterms:modified value typed as xsd:dateTime."@en ;
    ] ;

    sh:property [ sh:path dcterms:conformsTo ; sh:name "Application profile conformance"@en ; sh:description "The metadata document conforms to the versioned application profile identified by sapfoi:, distinct from the Turtle file referenced by rdfs:seeAlso."@en ; sh:order 10 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue sapfoi: ; sh:message "A metadata document must have exactly one dcterms:conformsTo pointing to <https://w3id.org/cnr-ismar/sap/featureOfInterest/1.0.0/>."@en ] .

###############################################################################
# Geometry shape
###############################################################################

foishape:GeometryShape
    a sh:NodeShape ;
    dcterms:isPartOf sapfoi: ;

    sh:name "Geometry"@en ;
    sh:description """
A GeoSPARQL geometry encoded as a three-dimensional WKT literal.

The geometry must have its own UUID version 4, distinct from its Feature's
identifier, expressed as dcterms:identifier and used in its IRI:
https://w3id.org/cnr-ismar/features-of-interest-registry/{ID}.ttl#geometry-{UUID}
In abbreviated Turtle, use the foireg: prefix and escape # with a backslash.
Blank nodes are not allowed. Exactly one dcterms:isPartOf must identify the
owning geo:Feature, which must link back to this geometry with geo:hasGeometry.
Both links must be explicit in the data; no inference is required.

The geometry must use CRS EPSG:4979 and must be encoded as:

POINT Z(longitude latitude elevation)

Longitude is the east coordinate and is written before latitude.
Longitude and latitude are expressed in decimal degrees.
Elevation is expressed as WGS84 ellipsoidal height in metres and may be
positive or negative.

The reference form generates the geometry as a geo:wktLiteral using:

<http://www.opengis.net/def/crs/EPSG/0/4979> POINT Z(lon lat elevation)
"""@en ;

    sh:targetClass geo:Geometry ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://w3id\\.org/cnr-ismar/features-of-interest-registry/[A-Za-z0-9][A-Za-z0-9_-]*[.]ttl#geometry-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" ;
    sh:message "A geometry must have an IRI following https://w3id.org/cnr-ismar/features-of-interest-registry/{ID}.ttl#geometry-{UUID}, using the owning Feature of Interest's ID and its own UUID version 4."@en ;

    sh:property [
        sh:path dcterms:identifier ;
        sh:name "Geometry UUID v4 identifier"@en ;
        sh:description "The geometry's own UUID v4, also used as the final component of its IRI."@en ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" ;
        sh:message "A geometry must have exactly one dcterms:identifier containing its own UUID version 4 as xsd:string."@en ;
    ] ;

    sh:property [
        sh:path dcterms:isPartOf ;
        sh:name "Owning Feature"@en ;
        sh:description "The single Feature represented by this geometry; it must explicitly link back using geo:hasGeometry."@en ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class geo:Feature ;
        sh:message "A geometry must have exactly one dcterms:isPartOf IRI identifying its owning geo:Feature."@en ;
    ] ;

    sh:property [
        sh:path [ sh:inversePath geo:hasGeometry ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:equals dcterms:isPartOf ;
        sh:message "The Feature linking to a geometry with geo:hasGeometry must be exactly the Feature identified by its dcterms:isPartOf."@en ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The geometry IRI must be the owning Feature's IRI followed by .ttl#geometry- and its dcterms:identifier UUID, which must differ from the Feature's UUID."@en ;
        sh:select """
            PREFIX dcterms: <http://purl.org/dc/terms/>
            PREFIX geo: <http://www.opengis.net/ont/geosparql#>
            SELECT $this
            WHERE {
                $this dcterms:identifier ?uuid ; dcterms:isPartOf ?owner .
                FILTER (
                    STR($this) != CONCAT(STR(?owner), ".ttl#geometry-", STR(?uuid))
                    || EXISTS {
                        ?feature geo:hasGeometry $this ; dcterms:identifier ?featureUUID .
                        FILTER (LCASE(STR(?featureUUID)) = LCASE(STR(?uuid)))
                    }
                )
            }
        """ ;
    ] ;

    ###########################################################################
    # rdf:type geo:Geometry
    ###########################################################################

    sh:property [
        sh:path rdf:type ;
        sh:hasValue geo:Geometry ;
        sh:name "Geometry type"@en ;
        sh:description "The geometry resource must be explicitly typed as geo:Geometry."@en ;
        sh:message "The geometry must be explicitly typed as geo:Geometry."@en ;
    ] ;

###########################################################################
    # geo:asWKT
    ###########################################################################

    sh:property [
        sh:path geo:asWKT ;
        sh:name "WKT geometry"@en ;
        sh:description "Three-dimensional WKT literal encoded using EPSG:4979. The WKT must be written as POINT Z(longitude latitude elevation), where longitude and latitude are decimal degrees and elevation is WGS84 ellipsoidal height in metres. Longitude must be between -180 and 180 degrees; latitude must be between -90 and 90 degrees."@en ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype geo:wktLiteral ;
        sh:pattern "^<http://www\\.opengis\\.net/def/crs/EPSG/0/4979>\\s+POINT\\s+Z\\s*\\(\\s*[-+]?(?:(?:1[0-7][0-9]|[1-9]?[0-9])(?:\\.[0-9]+)?|180(?:\\.0+)?)\\s+[-+]?(?:(?:[1-8]?[0-9])(?:\\.[0-9]+)?|90(?:\\.0+)?)\\s+[-+]?[0-9]+(?:\\.[0-9]+)?\\s*\\)$" ;
        sh:message "The WKT geometry must use EPSG:4979 and be encoded as POINT Z(longitude latitude elevation), with longitude between -180 and 180 degrees and latitude between -90 and 90 degrees."@en ;
    ] .
